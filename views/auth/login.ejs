<main class="min-h-screen flex items-center justify-center p-4 bg-stone-100 dark:bg-stone-950 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none opacity-40" style="background:radial-gradient(circle at 20% 20%,#bbf7d0,transparent 32%),radial-gradient(circle at 85% 80%,#fde68a,transparent 28%)"></div>
  <form class="login-card relative z-10" action="/admin/login" method="POST">
    <a href="/" class="text-sm text-emerald-700 dark:text-emerald-300 font-bold">← Back to visitor website</a>
    <div class="text-center my-6">
      <div class="mx-auto w-16 h-16 rounded-2xl bg-gradient-to-tr from-emerald-900 to-emerald-500 text-white grid place-items-center shadow-lg"><img src="/images/surajpur-virasat-symbol.svg" alt="" class="w-12 h-12"></div>
      <p class="text-xs uppercase tracking-[.18em] font-bold text-emerald-700 dark:text-emerald-300 mt-4">Surajpur Virasat</p>
      <h1 class="font-extrabold text-2xl sm:text-3xl mt-1">Admin Console</h1>
      <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">Manage destinations, QR locations and visitor content</p>
    </div>
    <label class="admin-label">Email address<input class="form-control" name="email" type="email" required autocomplete="username" placeholder="admin@example.com"></label>
    <label class="admin-label mt-4">Password<input class="form-control" name="password" type="password" required autocomplete="current-password" placeholder="Enter your password"></label>
    <button class="admin-btn w-full mt-6" type="submit">Sign in securely</button>
    <p class="text-xs text-stone-400 mt-4 text-center">Administrator access is restricted to authorised staff.</p>
  </form>
</main>
