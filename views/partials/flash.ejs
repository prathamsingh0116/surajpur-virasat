<% if (success && success.length) { %><div class="flash flash-success" role="status"><%= success[0] %><button onclick="this.parentElement.remove()">×</button></div><% } %>
<% if (error && error.length) { %><div class="flash flash-error" role="alert"><%= error[0] %><button onclick="this.parentElement.remove()">×</button></div><% } %>
